# Server
SERVER_PORT=8080
APP_ENV=development
LOG_LEVEL=info

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=secret
DB_NAME=geomapping_id
DB_SSLMODE=disable

# Auth (POST /api/v1/auth)
API_PUBLIC_KEY=pk_test_12345
API_PRIVATE_KEY=sk_test_67890
JWT_SECRET=change-me-in-production
JWT_EXPIRES_HOURS=24

# Rate limiting (requests per hour per API key)
RATE_LIMIT_PER_HOUR=100

# Redis (optional; set REDIS_ENABLED=false to skip)
REDIS_ENABLED=false
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# Data source paths for import scripts
DATA_DIR=./data
